{
  "manifest_version": 3,
  "name": "YUTorah Transcriber",
  "description": "Generate AI-powered notes from YUTorah shiurim with one click",
  "version": "1.0.0",
  "permissions": [],
  "host_permissions": [
    "*://*.yutorah.org/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.yutorah.org/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "button-style.css"
      ],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}